# Desarrollo aislado. Copiar a .env.local y completar desde la copia autorizada.
# Nunca copiar la conexion de una base publicada para desarrollar.
DATABASE_URL="postgresql://USUARIO:CONTRASENA_CODIFICADA@127.0.0.1:55439/llantas_unified_dev"
SHARED_DATABASE_MODE=true
SHARED_DATABASE_ENVIRONMENT=development
# UUID exacto de shared_runtime.configuration en la copia elegida.
SHARED_DATABASE_ID=""
DB_REQUIRE_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
LLANTERA_SUPPLIER="COMERCIALIZADORA DE NEW TIRES"

# CENTRAL_INVENTORY_DATABASE_URL debe estar ausente en modo compartido.
# Para produccion usar environment=production, su UUID y el usuario existente
# autorizado en la base principal. Consultar SHARED_DATABASE.txt antes del corte.
