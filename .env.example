# Plantilla sin secretos para el destino PostgreSQL publicado ya preparado.
# No sobrescribir una conexión existente ni copiar las credenciales del origen.
# Se reutiliza el usuario existente elegido para el destino; no se crea otro rol.
# La contraseña debe codificarse como componente de URL.
DATABASE_URL="postgresql://admmin:CONTRASENA_CODIFICADA@SERVIDOR_APROBADO:5432/postgres"
LLANTERA_EXPECTED_DATABASE=postgres
LLANTERA_SUPPLIER="COMERCIALIZADORA DE NEW TIRES"

# Obligatoria: llm: seguido por los primeros 48 hex del SHA-256 del artefacto
# revisado. Copiar el valor applicationName del plan; no inventar una marca.
# Esta marca identifica la versión y no es una contraseña.
LLANTERA_APPLICATION_ID=""

# Llantas: conexión adicional al inventario central (esquema multi_inventory).
# DATABASE_URL conserva servicios, productos, tickets e históricos de Multi.
# Usar un rol limitado a la vista NEW TIRES y las cuatro funciones de stock.
# Nunca usar el administrador de la base central en la aplicación.
CENTRAL_INVENTORY_DATABASE_URL="postgresql://llantera_multi_stock:CONTRASENA_CODIFICADA@SERVIDOR_CENTRAL:5432/postgres"
CENTRAL_INVENTORY_REQUIRE_SSL=true
CENTRAL_INVENTORY_SSL_REJECT_UNAUTHORIZED=true

# Ajustar al endpoint real. Validar el certificado cuando se utilice TLS.
DB_REQUIRE_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Desarrollo: usar el endpoint/rol del clon preparado y sustituir /postgres
# y LLANTERA_EXPECTED_DATABASE por el mismo nombre exacto de ese clon.
# La aplicación exige migration_new_tires.runtime_setup versión 1.
# En producción, las escrituras permanecen bloqueadas hasta la activación
# documentada. Después exigen el usuario existente y la marca exacta del plan.
